<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.dailybriefing.agent</string>

    <key>ProgramArguments</key>
    <array>
        <string>__APP_DIR__/run.sh</string>
        <string>--quiet</string>
    </array>

    <key>WorkingDirectory</key>
    <string>__APP_DIR__</string>

    <!-- Daily at 08:00 local time. If the Mac is asleep at 08:00, launchd runs
         the job as soon as it wakes, so a missed morning still gets delivered. -->
    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>8</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>__APP_DIR__/state/logs/launchd.out.log</string>
    <key>StandardErrorPath</key>
    <string>__APP_DIR__/state/logs/launchd.err.log</string>

    <key>ProcessType</key>
    <string>Background</string>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
</dict>
</plist>
