[Unit]
Description=Daily AI + Cyber Security briefing
Documentation=file:%h/briefing/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/briefing
ExecStart=%h/briefing/run.sh --quiet

# The feeds are external and occasionally slow; never let a run hang forever.
TimeoutStartSec=600

# Hardening is limited to what a --user manager can actually apply.
#
# ProtectKernelTunables, ProtectKernelModules, ProtectControlGroups and
# RestrictSUIDSGID all drop capabilities, which an unprivileged user manager
# cannot do: the unit then fails with 218/CAPABILITIES *before* ExecStart runs,
# so the briefing silently never happens. They are system-service-only.
# Do not add them back to this unit.
#
# The options below are namespace-based and work fine unprivileged.
# ProtectSystem=strict mounts everything read-only, so state/ must be named
# explicitly - SQLite writes both the database and its journal there.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/briefing/state

StandardOutput=append:%h/briefing/state/logs/systemd.out.log
StandardError=append:%h/briefing/state/logs/systemd.err.log

[Install]
WantedBy=default.target
