[Unit]
Description=Daily AI + Cyber Security briefing
Documentation=file:%h/briefing/README.md
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=%h/briefing
ExecStart=%h/briefing/run.sh --quiet

# The feeds are external and occasionally slow; never let a run hang forever.
TimeoutStartSec=600

# ProtectSystem=strict mounts the whole hierarchy read-only, so state/ must be
# named explicitly - SQLite writes both the database and its journal there.
# Hardening is kept to options that are well-behaved with CPython; anything
# exotic here would trade a real 08:00 delivery for a theoretical gain.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=%h/briefing/state
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true

StandardOutput=append:%h/briefing/state/logs/systemd.out.log
StandardError=append:%h/briefing/state/logs/systemd.err.log

[Install]
WantedBy=default.target
