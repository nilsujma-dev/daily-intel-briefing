# ---- credentials: never commit -------------------------------------------
# "secrets/" would exclude the directory itself, and git cannot re-include a
# file whose parent directory is excluded - the guide would silently vanish.
# Excluding the *contents* keeps the negation working.
secrets/*
!secrets/README.md
*.pem
*.key
id_rsa*
id_ed25519*
*client_secret*.json
*token.json
.env
.env.*

# ---- personal configuration ----------------------------------------------
config/settings.local.json
config/feeds.local.json
deploy.local.conf

# ---- runtime state: databases, logs, previews ----------------------------
state/*
!state/.gitkeep
*.db
*.db-journal
*.db-wal
*.db-shm

# ---- python / os ----------------------------------------------------------
__pycache__/
*.py[cod]
.DS_Store
.venv/
venv/
